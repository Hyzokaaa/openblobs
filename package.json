{
  "name": "openblobs",
  "version": "0.1.0",
  "description": "Deterministic, friendly SVG avatars from any string. Zero dependencies.",
  "license": "MIT",
  "author": "Luis Miguel Lagos Xenes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyzokaaa/openblobs.git"
  },
  "homepage": "https://github.com/Hyzokaaa/openblobs#readme",
  "bugs": {
    "url": "https://github.com/Hyzokaaa/openblobs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./designs": {
      "types": "./dist/designs/index.d.ts",
      "import": "./dist/designs/index.js",
      "default": "./dist/designs/index.js"
    },
    "./designs/*": {
      "types": "./dist/designs/*.d.ts",
      "import": "./dist/designs/*.js",
      "default": "./dist/designs/*.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && node scripts/preview.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "avatar",
    "svg",
    "identicon",
    "deterministic",
    "react"
  ]
}
